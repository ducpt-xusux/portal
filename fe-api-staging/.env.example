# Dev: Vite proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=/api
VITE_PORTAL_API_BASE_URL=/api/v1
# Production with separate origins: set each API base to its actual origin/path.
# Session cookies, CORS and CSRF must be configured by the v4 backend.
# Never place OpenStack credentials or backend secrets in VITE_* variables.
