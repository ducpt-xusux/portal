AUDIT_PATH=/var/lib/n91-portal/p16h-import.jsonl
AUDIT_MODE=snapshot
P16H_IMPORT_CONTEXT=IMPORTED_UNVERIFIED
DATABASE_PATH=/var/lib/n91-portal/portal.sqlite3
V4_AUDIT_ENABLED=true
P17_SNAPSHOT_PATH=/var/lib/n91-portal/p17.json

PORTAL_SESSION_AUTH=true
PORTAL_SESSION_LOCAL_HTTP=true
PORTAL_BUSINESS_DATABASE=/var/lib/n91-portal/business.sqlite3
CORS_ORIGINS=http://127.0.0.1:5188

OPENSTACK_INVENTORY_ENABLED=false
OPENSTACK_CONSOLE_ENABLED=false
# Enable inventory after verifying routes and provisioning a read-only credential.
# OPENSTACK_CREDENTIAL_PATH=/etc/n91-portal/openstack-inventory.json
# OPENSTACK_AUTH_URL=http://controller.example:5000/v3
# OPENSTACK_COMPUTE_URL=http://controller.example:8774/v2.1
# OPENSTACK_NETWORK_URL=http://controller.example:9696
# OPENSTACK_PROJECT_ID=<inventory-project-id>

# PORTAL_EVIDENCE_INDEX=/var/lib/n91-portal/evidence/index.json
# Configure policy and Controller artifacts separately with their SHA256 pins.
