[Unit]
Description=N91 Portal local P17 VNext read-only snapshot
After=db-firewall-p17.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/portal-local
ExecStart=/home/ubuntu/portal-local/.venv313/bin/python -B /home/ubuntu/portal-local/vnext_tools/publish_vnext.py --db /var/lib/db-firewall-p17/state.sqlite3 --out /home/ubuntu/portal-local/vnext_data/p17_vnext.json
TimeoutStartSec=25s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/portal-local/vnext_data
