[Unit]
Description=N91 clone-only automatic response worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=controller
Group=controller
EnvironmentFile=/home/controller/.n91-auto-runtime/runtime.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/controller/.n91-auto-runtime/venv/bin/python -m app.auto_response --config /home/controller/.n91-auto-runtime/config.json run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/controller/.n91-auto-runtime/state
PrivateTmp=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
